            const wName = player ? weaponNames[Math.min(player.weaponLevel - 1, 3)] : 'PULSE MK-I';
            document.getElementById('hud-weapon').textContent = wName;

            const shieldContainer = document.getElementById('hud-shields');
            shieldContainer.innerHTML = '';
            const maxS = player ? player.maxShields : 4;
            const curS = player ? player.shields : 4;
            for (let i = 0; i < maxS; i++) {
                const bar = document.createElement('div');
                bar.className = `w-3.5 h-3 rounded-sm transition-all ${
                    i < curS
                        ? 'bg-cyan-400 shadow-[0_0_8px_#00f3ff]'
                        : 'bg-slate-800 border border-slate-700'
                }`;
                shieldContainer.appendChild(bar);
            }

            const bombContainer = document.getElementById('hud-bombs');
            bombContainer.innerHTML = '';
            const bombs = player ? player.bombs : 2;
            for (let i = 0; i < 3; i++) {
                const icon = document.createElement('i');
                icon.className = `fa-solid fa-circle-radiation text-xs ${
                    i < bombs ? 'text-amber-400 glow-amber' : 'text-slate-700'
                }`;
                bombContainer.appendChild(icon);
            }
        }

        function updateBossHUD(hp, maxHp) {
            const pct = Math.max(0, Math.min(100, Math.round((hp / maxHp) * 100)));
            document.getElementById('boss-hp-text').textContent = `${pct}%`;
            document.getElementById('boss-hp-bar').style.width = `${pct}%`;
        }

        function showSectorBanner(title, subtitle) {
            const banner = document.getElementById('sector-banner');
            document.getElementById('sector-banner-title').textContent = title;
            document.getElementById('sector-banner-sub').textContent = subtitle;
            banner.classList.remove('hidden');
            setTimeout(() => {
                banner.classList.add('hidden');
            }, 2200);
        }

        function triggerNovaBomb() {
            if (state.mode !== 'PLAYING' || !player || player.bombs <= 0) return;
            player.bombs--;
            sound.playNovaBomb();
            Haptics.emp();
            state.screenShake = 2.4;

            // Giant 3D Expanding EMP Torus Wave
            const empGeo = new THREE.TorusGeometry(2.5, 0.6, 12, 40);
            empGeo.rotateX(Math.PI / 2);
            const empMat = new THREE.MeshBasicMaterial({
                color: 0x00f3ff,
                transparent: true,
                opacity: 0.95
            });
            const empMesh = new THREE.Mesh(empGeo, empMat);
            empMesh.position.set(player.x, player.y, player.z);
            scene.add(empMesh);
            empShockwaves.push({
                mesh: empMesh,
                rate: 115,
                life: 0.75,
                maxLife: 0.75
            });

            // Vaporize all enemy projectiles
            for (const eb of enemyBullets) scene.remove(eb.mesh);
            enemyBullets = [];

            // Damage all active 3D enemies
            for (let i = enemies.length - 1; i >= 0; i--) {
                const e = enemies[i];
                e.hp -= 18;
                create3DExplosion(e.x, e.y, e.z, 0xffbe0b, 14, false);
                if (e.hp <= 0) {
                    handleEnemyDefeat(e, i);
                } else if (e.type === 'BOSS') {
                    updateBossHUD(e.hp, e.maxHp);
                }
            }
            addFloatingText3D(player.x, player.y + 3, player.z, '3D NOVA EMP UNLEASHED!', '#ffbe0b');
            updateHUD();
        }

        function handleEnemyDefeat(e, index) {
            const gained = Math.round(e.points * state.combo);
            state.score += gained;
            Haptics.hit();
            if (state.score > highScore) {
                highScore = state.score;
                localStorage.setItem(STORAGE_KEY, String(highScore));
            }

            state.combo = Math.min(8.0, +(state.combo + 0.2).toFixed(1));
            state.comboTimer = 4.0;

            create3DExplosion(
                e.x,
                e.y,
                e.z,
                e.colorHex,
                e.type === 'BOSS' ? 55 : 22,
                e.type === 'BOSS' || e.type === 'CRUISER'
            );
            addFloatingText3D(e.x, e.y, e.z, `+${gained}`, e.color);
            maybeSpawnPowerUp(e.x, e.z);

            if (e.type === 'BOSS') {
                state.bossActive = false;
                document.getElementById('boss-hud').classList.add('hidden');
                state.waveEnemiesRemaining = 0;
            } else {
                state.waveEnemiesRemaining--;
            }

            scene.remove(e.mesh);
            enemies.splice(index, 1);

            if (state.waveEnemiesRemaining <= 0 && enemies.length === 0 && !state.bossActive) {
                advanceLevel();
            }
            updateHUD();
        }

        function advanceLevel() {
            state.level++;
            sound.playPowerUp();

            if (state.level % 3 === 0) {
                state.waveEnemiesRemaining = 1;
                spawnBoss();
            } else {
                state.waveEnemiesRemaining = 10 + state.level * 4;
                showSectorBanner(`SECTOR ${String(state.level).padStart(2, '0')}`, `3D SWARM VELOCITY INCREASED`);
            }
            updateHUD();
        }

        function damagePlayer() {
            player.shields--;
            player.invulnTimer = 1.6;
            state.combo = 1.0;
            state.screenShake = 2.0;
            Haptics.damage();
            if (player.weaponLevel > 1) player.weaponLevel--;
            create3DExplosion(player.x, player.y, player.z, 0xff007f, 28, true);
            updateHUD();

            if (player.shields <= 0) {
                triggerGameOver();
            }
        }

        // --- 8. MAIN 3D SIMULATION & CAMERA UPDATE LOOP ---
        function update3DCamera(dt) {
            const mode = CAMERA_MODES[state.cameraModeIndex];
            const px = player ? player.x : 0;
            const pz = player ? player.z : 24;

            let targetPos = new THREE.Vector3();
            let lookTarget = new THREE.Vector3();

            if (mode === 'CHASE') {
                targetPos.set(
                    px * 0.68 + Math.sin(state.camOrbitYaw) * 18,
                    16 + state.camOrbitPitch * 12,
                    pz + 20
                );
                lookTarget.set(px * 0.45, 0, pz - 32);
            } else if (mode === 'COCKPIT') {
                targetPos.set(px, 2.5, pz - 0.5);
                lookTarget.set(px + Math.sin(state.camOrbitYaw) * 12, 0.5 - state.camOrbitPitch * 6, pz - 60);
            } else {
                // TACTICAL (Elevated Angled Arcade Cam)
                targetPos.set(px * 0.25 + Math.sin(state.camOrbitYaw) * 24, 48 + state.camOrbitPitch * 14, pz + 32);
                lookTarget.set(0, 0, -22);
            }

            if (state.screenShake > 0) {
                state.screenShake = Math.max(0, state.screenShake - dt * 4.5);
                targetPos.x += (Math.random() - 0.5) * state.screenShake;
                targetPos.y += (Math.random() - 0.5) * state.screenShake;
            }

            camera.position.lerp(targetPos, Math.min(1, dt * 10));
            camera.lookAt(lookTarget);
        }

        function updateEnvironment3D(dt) {
            const speedMult = state.mode === 'PLAYING' ? 52 : 18;

            // Scroll 3D Grid Floor
            gridGroup.position.z += speedMult * dt;
            if (gridGroup.position.z >= 240) {
                gridGroup.position.z -= 240;
            }

            // Scroll Side Cyber Pillars
            for (const arch of cyberArches) {
                arch.position.z += speedMult * dt;
                if (arch.position.z > 55) {
                    arch.position.z -= 240;
                }
            }

            // Scroll 3D Volumetric Stars
            const posAttr = starGeo.getAttribute('position');
            for (let i = 0; i < posAttr.count; i++) {
                let z = posAttr.getZ(i) + speedMult * 1.4 * dt;
                if (z > 55) z -= 260;
                posAttr.setZ(i, z);
            }
            posAttr.needsUpdate = true;

            // Decay Explosion Light
            if (explosionLight.intensity > 0) {
                explosionLight.intensity = Math.max(0, explosionLight.intensity - dt * 15);
            }
        }

        function updateGame(dt) {
            updateEnvironment3D(dt);
            update3DCamera(dt);

            if (state.mode !== 'PLAYING') return;

            // Combo Timer
            if (state.comboTimer > 0) {
                state.comboTimer -= dt;
                if (state.comboTimer <= 0 && state.combo > 1.0) {
                    state.combo = 1.0;
                    updateHUD();
                }
            }

            player.update(dt);

            // Spawn Enemies
            if (!state.bossActive && enemies.length < 5 + Math.floor(state.level / 2) && state.waveEnemiesRemaining > enemies.length) {
                state.spawnTimer -= dt;
                if (state.spawnTimer <= 0) {
                    spawnEnemy();
                    state.spawnTimer = Math.max(0.45, 1.3 - state.level * 0.08);
                }
            }

            // Update Player 3D Laser Bolts
            for (let i = bullets.length - 1; i >= 0; i--) {
                const b = bullets[i];
                b.x += b.vx * dt;
                b.z += b.vz * dt;
                b.mesh.position.set(b.x, b.y, b.z);

                if (b.z < WORLD.spawnZ - 15 || Math.abs(b.x) > WORLD.xBound + 20) {
                    scene.remove(b.mesh);
                    bullets.splice(i, 1);
                }
            }

            // Update Enemy 3D Plasma Bolts
            for (let i = enemyBullets.length - 1; i >= 0; i--) {
                const eb = enemyBullets[i];
                eb.x += eb.vx * dt;
                eb.z += eb.vz * dt;
                eb.mesh.position.set(eb.x, eb.y, eb.z);
                eb.mesh.rotation.x += dt * 6;
                eb.mesh.rotation.y += dt * 6;

                if (player.invulnTimer <= 0 && Math.hypot(eb.x - player.x, eb.z - player.z) < eb.radius + player.radius - 0.4) {
                    scene.remove(eb.mesh);
                    enemyBullets.splice(i, 1);
                    damagePlayer();
                    continue;
                }

                if (eb.z > WORLD.despawnZ || eb.z < WORLD.spawnZ - 20 || Math.abs(eb.x) > WORLD.xBound + 22) {
                    scene.remove(eb.mesh);
                    enemyBullets.splice(i, 1);
                }
            }

            // Update 3D Enemies
            for (let i = enemies.length - 1; i >= 0; i--) {
                const e = enemies[i];
                e.age += dt;

                if (e.type === 'SCOUT') {
                    e.x += Math.sin(e.age * 3.5) * 22 * dt;
                    e.z += e.vz * dt;
                } else if (e.type === 'INTERCEPTOR') {
                    const dir = Math.sign(player.x - e.x);
                    e.x += dir * 14 * dt;
                    e.z += e.vz * dt;
                    e.mesh.rotation.z = -dir * 0.4;
                } else if (e.type === 'CRUISER') {
                    e.x += e.vx * dt;
                    e.z += e.vz * dt;
                    if (Math.abs(e.x) > WORLD.xBound - 4) e.vx *= -1;
                } else if (e.type === 'BOSS') {
                    if (e.z < -52) {
                        e.z += e.vz * dt;
                    } else {
                        e.x += e.vx * dt;
                        if (Math.abs(e.x) > WORLD.xBound - 10) e.vx *= -1;
                    }
                    if (e.mesh.userData.gyroPart) {
                        e.mesh.userData.gyroPart.rotation.z += dt * 2.5;
                        e.mesh.userData.gyroPart.rotation.x = Math.sin(e.age * 2) * 0.35;
                    }
                }

                e.x = Math.max(-WORLD.xBound, Math.min(WORLD.xBound, e.x));
                e.mesh.position.set(e.x, e.y, e.z);
                if (e.mesh.userData.spinPart) {
                    e.mesh.userData.spinPart.rotation.y += dt * 3.2;
                }

                // Enemy Weapon Fire
                e.shootTimer -= dt;
                if (e.shootTimer <= 0 && e.z > WORLD.spawnZ + 20 && e.z < player.z - 6) {
                    if (e.type === 'SCOUT') {
                        e.shootTimer = 2.0;
                        spawnEnemyBullet(e.x, e.z + 2, 0, 52, 0xff007f);
                    } else if (e.type === 'INTERCEPTOR') {
                        e.shootTimer = 1.5;
                        const ang = Math.atan2(player.x - e.x, player.z - e.z);
                        spawnEnemyBullet(e.x, e.z + 2, Math.sin(ang) * 58, Math.cos(ang) * 58, 0xff007f);
                    } else if (e.type === 'CRUISER') {
                        e.shootTimer = 1.75;
                        [-0.32, 0, 0.32].forEach(offset => {
                            spawnEnemyBullet(
                                e.x,
                                e.z + 3,
                                Math.sin(offset) * 50,
                                Math.cos(offset) * 50,
                                0xffbe0b,
                                1.05
                            );
                        });
                    } else if (e.type === 'BOSS') {
                        e.shootTimer = 0.9;
                        const count = 7;
                        for (let k = 0; k < count; k++) {
                            const spread = -0.65 + (k / (count - 1)) * 1.3 + Math.sin(e.age * 2) * 0.2;
                            spawnEnemyBullet(
                                e.x,
                                e.z + 5,
                                Math.sin(spread) * 56,
                                Math.cos(spread) * 56,
                                0xff0055,
                                1.15
                            );
                        }
                    }
                }

                // Check Player Laser Hits vs Enemy
                let destroyed = false;
                for (let j = bullets.length - 1; j >= 0; j--) {
                    const b = bullets[j];
                    if (Math.hypot(b.x - e.x, b.z - e.z) < e.radius + b.radius) {
                        scene.remove(b.mesh);
                        bullets.splice(j, 1);
                        e.hp -= b.dmg;
                        sound.playHit();

                        if (e.type === 'BOSS') updateBossHUD(e.hp, e.maxHp);

                        if (e.hp <= 0) {
                            handleEnemyDefeat(e, i);
                            destroyed = true;
                            break;
                        }
                    }
                }
                if (destroyed) continue;

                // Enemy vs Player Ship Collision
                if (player.invulnTimer <= 0 && Math.hypot(e.x - player.x, e.z - player.z) < e.radius + player.radius - 0.5) {
                    damagePlayer();
                    if (e.type !== 'BOSS') {
                        create3DExplosion(e.x, e.y, e.z, e.colorHex, 18, false);
                        scene.remove(e.mesh);
                        enemies.splice(i, 1);
                        continue;
                    }
                }

                // Recycle enemy back to deep space if it passes behind camera
                if (e.z > WORLD.despawnZ) {
                    e.z = WORLD.spawnZ;
                    e.x = (Math.random() - 0.5) * (WORLD.xBound * 1.7);
                }
            }

            // Update 3D Power-Up Holocrons
            for (let i = powerUps.length - 1; i >= 0; i--) {
                const p = powerUps[i];
                p.z += p.vz * dt;
                p.mesh.position.set(p.x, p.y, p.z);
                p.mesh.rotation.y += dt * 3;
                p.mesh.rotation.x += dt * 2;

                if (Math.hypot(p.x - player.x, p.z - player.z) < p.radius + player.radius) {
                    sound.playPowerUp();
                    Haptics.powerUp();
                    if (p.id === 'WEAPON') {
                        player.weaponLevel = Math.min(4, player.weaponLevel + 1);
                        addFloatingText3D(player.x, player.y + 2, player.z, 'WEAPON OVERDRIVE!', '#39ff14');
                    } else if (p.id === 'SHIELD') {
                        player.shields = Math.min(player.maxShields, player.shields + 1);
                        addFloatingText3D(player.x, player.y + 2, player.z, 'SHIELD RESTORED!', '#00f3ff');
                    } else if (p.id === 'BOMB') {
                        player.bombs = Math.min(3, player.bombs + 1);
                        addFloatingText3D(player.x, player.y + 2, player.z, 'NOVA EMP +1', '#ffbe0b');
                    }
                    state.score += 250;
                    updateHUD();
                    scene.remove(p.mesh);
                    powerUps.splice(i, 1);
                    continue;
                }

                if (p.z > WORLD.despawnZ) {
                    scene.remove(p.mesh);
                    powerUps.splice(i, 1);
                }
            }

            // Update 3D Volumetric Particles
            for (let i = particles.length - 1; i >= 0; i--) {
                const pt = particles[i];
                pt.mesh.position.x += pt.vx * dt;
                pt.mesh.position.y += pt.vy * dt;
                pt.mesh.position.z += pt.vz * dt;
                pt.mesh.rotation.x += dt * 5;
                pt.mesh.rotation.y += dt * 5;
                pt.life -= dt;

                const alpha = Math.max(0, pt.life / pt.maxLife);
                pt.mesh.material.opacity = alpha;
                pt.mesh.scale.setScalar(alpha);

                if (pt.life <= 0) {
                    scene.remove(pt.mesh);
                    particles.splice(i, 1);
                }
            }

            // Update Expanding 3D Shockwave Rings
            for (let i = empShockwaves.length - 1; i >= 0; i--) {
                const sw = empShockwaves[i];
                sw.life -= dt;
                const scale = 1 + (1 - sw.life / sw.maxLife) * sw.rate;
                sw.mesh.scale.setScalar(scale);
                sw.mesh.material.opacity = Math.max(0, sw.life / sw.maxLife);
                if (sw.life <= 0) {
                    scene.remove(sw.mesh);
                    empShockwaves.splice(i, 1);
                }
            }

            // Update Projected 3D-to-2D Floating Combat Text
            const projVec = new THREE.Vector3();
            for (let i = floatingTexts.length - 1; i >= 0; i--) {
                const ft = floatingTexts[i];
                ft.y += 6 * dt;
                ft.life -= dt;

                projVec.set(ft.x, ft.y, ft.z);
                projVec.project(camera);

                const screenX = (projVec.x * 0.5 + 0.5) * state.width;
                const screenY = (-projVec.y * 0.5 + 0.5) * state.height;

                ft.el.style.left = `${screenX}px`;
                ft.el.style.top = `${screenY}px`;
                ft.el.style.opacity = String(Math.max(0, ft.life / ft.maxLife));

                if (ft.life <= 0) {
                    ft.el.remove();
                    floatingTexts.splice(i, 1);
                }
            }
        }

        // --- 9. GAME FLOW CONTROLLERS & CLEANUP ---
        const modalOverlay = document.getElementById('modal-overlay');
        const modalTitle = document.getElementById('modal-title');
        const modalSubtitle = document.getElementById('modal-subtitle');
        const modalBadge = document.getElementById('modal-badge');
        const modalStats = document.getElementById('modal-stats');
        const btnModalPrimary = document.getElementById('btn-modal-primary');
        const btnModalRestart = document.getElementById('btn-modal-restart');

        function clearEntities3D() {
            if (player) player.destroy();
            bullets.forEach(b => scene.remove(b.mesh));
            enemyBullets.forEach(eb => scene.remove(eb.mesh));
            enemies.forEach(e => scene.remove(e.mesh));
            particles.forEach(pt => scene.remove(pt.mesh));
            powerUps.forEach(p => scene.remove(p.mesh));
            empShockwaves.forEach(sw => scene.remove(sw.mesh));
            floatingTexts.forEach(ft => ft.el.remove());

            bullets = [];
            enemyBullets = [];
            enemies = [];
            particles = [];
            powerUps = [];
            empShockwaves = [];
            floatingTexts = [];
        }

        function startNewGame() {
            sound.init();
            resizeCanvas();
            clearEntities3D();

            state.score = 0;
            state.level = 1;
            state.combo = 1.0;
            state.comboTimer = 0;
            state.waveEnemiesRemaining = 12;
            state.bossActive = false;
            state.mode = 'PLAYING';

            player = new Player3D();

            document.getElementById('boss-hud').classList.add('hidden');
            modalOverlay.classList.add('hidden');
            updatePauseButtonUI();
            updateHUD();
            showSectorBanner('SECTOR 01', 'ENGAGE 3D HOSTILE ARMADA');
        }

        function togglePause() {
            if (state.mode === 'PLAYING') {
                state.mode = 'PAUSED';
                modalBadge.innerHTML = '<i class="fa-solid fa-pause"></i> SYSTEM STANDBY';
                modalTitle.textContent = 'MISSION PAUSED';
                modalSubtitle.textContent = 'Take a breather, Commander. Your 3D interceptor is holding position.';
                modalStats.classList.add('hidden');
                btnModalPrimary.innerHTML = '<i class="fa-solid fa-play"></i> RESUME MISSION';
                btnModalRestart.classList.remove('hidden');
                modalOverlay.classList.remove('hidden');
            } else if (state.mode === 'PAUSED') {
                state.mode = 'PLAYING';
                modalOverlay.classList.add('hidden');
            }
            updatePauseButtonUI();
        }

        function triggerGameOver() {
            state.mode = 'GAMEOVER';
            sound.playGameOver();

            modalBadge.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i> HULL BREACH DETECTED';
            modalTitle.textContent = 'MISSION FAILED';
            modalSubtitle.textContent = 'Your 3D interceptor was overwhelmed by the sector armada.';
            document.getElementById('stat-final-score').textContent = Math.floor(state.score).toLocaleString();
            document.getElementById('stat-final-level').textContent = `SECTOR ${state.level}`;
            modalStats.classList.remove('hidden');

            btnModalPrimary.innerHTML = '<i class="fa-solid fa-rotate-right"></i> LAUNCH AGAIN';
            btnModalRestart.classList.add('hidden');
            modalOverlay.classList.remove('hidden');
            updatePauseButtonUI();
        }

        function updatePauseButtonUI() {
            const icon = document.getElementById('icon-pause');
            const text = document.getElementById('text-pause');
            if (state.mode === 'PAUSED') {
                icon.className = 'fa-solid fa-play';
                text.textContent = 'RESUME';
            } else {
                icon.className = 'fa-solid fa-pause';
                text.textContent = 'PAUSE';
            }
        }

        function cycleCameraMode() {
            state.cameraModeIndex = (state.cameraModeIndex + 1) % CAMERA_MODES.length;
            state.camOrbitYaw = 0;
            state.camOrbitPitch = 0;
            const modeName = CAMERA_MODES[state.cameraModeIndex];
            document.getElementById('text-camera').textContent = `CAM: ${modeName}`;
            document.getElementById('hud-cam-label').textContent = `CAM: ${modeName} 3D (DRAG RIGHT-CLICK OR PRESS C)`;
        }

        function resizeCanvas() {
            const wrapper = document.getElementById('canvas-wrapper');
            const rect = wrapper.getBoundingClientRect();
            state.width = rect.width;
            state.height = rect.height;
            if (renderer && camera) {
                renderer.setSize(state.width, state.height);
                camera.aspect = state.width / state.height;
                camera.updateProjectionMatrix();
            }
        }

        // --- 10. INPUT LISTENERS (KEYBOARD, MOUSE, CAMERA ORBIT, TOUCH) ---
        window.addEventListener('resize', resizeCanvas);

        window.addEventListener('keydown', (e) => {
            if (e.code in keys) {
                keys[e.code] = true;
                if (e.code === 'Space' || e.code.startsWith('Arrow')) e.preventDefault();
            }
            if (e.code === 'KeyP' || e.code === 'Escape') {
                if (state.mode === 'PLAYING' || state.mode === 'PAUSED') togglePause();
            } else if (e.code === 'KeyR') {
                startNewGame();
            } else if (e.code === 'KeyB' || e.code === 'ShiftLeft' || e.code === 'ShiftRight') {
                triggerNovaBomb();
            } else if (e.code === 'KeyC') {
                cycleCameraMode();
            } else if (e.code === 'KeyM') {
                toggleAudioUI();
            }
        });

        window.addEventListener('keyup', (e) => {
            if (e.code in keys) keys[e.code] = false;
        });

        // Map screen pointer coordinates onto 3D combat plane (Y = 0)
        const raycaster = new THREE.Raycaster();
        const combatPlane = new THREE.Plane(new THREE.Vector3(0, 1, 0), 0);
        const intersectPt = new THREE.Vector3();

        function updatePointer3D(clientX, clientY) {
            const rect = canvas.getBoundingClientRect();
            pointer.ndcX = ((clientX - rect.left) / rect.width) * 2 - 1;
            pointer.ndcY = -((clientY - rect.top) / rect.height) * 2 + 1;

            raycaster.setFromCamera({ x: pointer.ndcX, y: pointer.ndcY }, camera);
            if (raycaster.ray.intersectPlane(combatPlane, intersectPt)) {
                pointer.worldX = Math.max(-WORLD.xBound, Math.min(WORLD.xBound, intersectPt.x));
                pointer.worldZ = Math.max(WORLD.zMin, Math.min(WORLD.zMax, intersectPt.z - 4));
            }
        }

        canvas.addEventListener('contextmenu', (e) => e.preventDefault());

        canvas.addEventListener('mousedown', (e) => {
            if (e.button === 2 || e.shiftKey) {
                // Right-click or Shift+Drag adjusts 3D camera orbit angle
                state.isOrbitDragging = true;
                state.orbitLastX = e.clientX;
                state.orbitLastY = e.clientY;
            } else {
                pointer.active = true;
                updatePointer3D(e.clientX, e.clientY);
            }
        });

        window.addEventListener('mousemove', (e) => {
            if (state.isOrbitDragging) {
                const dx = e.clientX - state.orbitLastX;
                const dy = e.clientY - state.orbitLastY;
                state.orbitLastX = e.clientX;
                state.orbitLastY = e.clientY;
                state.camOrbitYaw = Math.max(-0.85, Math.min(0.85, state.camOrbitYaw - dx * 0.006));
                state.camOrbitPitch = Math.max(-0.6, Math.min(0.8, state.camOrbitPitch + dy * 0.006));
            } else if (pointer.active) {
                updatePointer3D(e.clientX, e.clientY);
            }
        });

        window.addEventListener('mouseup', () => {
            pointer.active = false;
            state.isOrbitDragging = false;
        });

        canvas.addEventListener('touchstart', (e) => {
            e.preventDefault();
            sound.init();
            pointer.active = true;
            const touch = e.touches[0];
            updatePointer3D(touch.clientX, touch.clientY);
        }, { passive: false });

        canvas.addEventListener('touchmove', (e) => {
            e.preventDefault();
            if (pointer.active && e.touches.length > 0) {
                const touch = e.touches[0];
                updatePointer3D(touch.clientX, touch.clientY);
            }
        }, { passive: false });

        canvas.addEventListener('touchend', (e) => {
            e.preventDefault();
            pointer.active = false;
        }, { passive: false });

        // UI Button Listeners
        btnModalPrimary.addEventListener('click', () => {
            if (state.mode === 'PAUSED') {
                togglePause();
            } else {
                startNewGame();
            }
        });

        btnModalRestart.addEventListener('click', startNewGame);
        document.getElementById('btn-pause').addEventListener('click', togglePause);
        document.getElementById('btn-restart').addEventListener('click', startNewGame);
        document.getElementById('btn-bomb').addEventListener('click', triggerNovaBomb);
        document.getElementById('btn-camera').addEventListener('click', cycleCameraMode);

        document.getElementById('btn-autofire').addEventListener('click', () => {
            state.autoFire = !state.autoFire;
            document.getElementById('text-autofire').textContent = `AUTOFIRE: ${state.autoFire ? 'ON' : 'OFF'}`;
            document.getElementById('touch-fire-label').textContent = state.autoFire ? 'AUTO' : 'FIRE';
        });

        function toggleAudioUI() {
            const on = sound.toggle();
            document.getElementById('icon-sound').className = on
                ? 'fa-solid fa-volume-high text-cyan-300'
                : 'fa-solid fa-volume-xmark text-rose-400';
            document.getElementById('text-sound').textContent = `AUDIO: ${on ? 'ON' : 'OFF'}`;
        }
        document.getElementById('btn-sound').addEventListener('click', toggleAudioUI);

        // --- 10B. NATIVE APP CONTROLS: VIRTUAL THUMBSTICK, ACTION PAD, FULLSCREEN & MODALS ---
        const joystickBase = document.getElementById('joystick-base');
        const joystickStick = document.getElementById('joystick-stick');
        const joystickContainer = document.getElementById('joystick-container');

        function handleJoystickMove(clientX, clientY) {
            const rect = joystickBase.getBoundingClientRect();
            const centerX = rect.left + rect.width / 2;
            const centerY = rect.top + rect.height / 2;
            let dx = clientX - centerX;
            let dy = clientY - centerY;
            const dist = Math.hypot(dx, dy);
            const maxR = joystick.maxRadius;

            if (dist > maxR) {
                dx = (dx / dist) * maxR;
                dy = (dy / dist) * maxR;
            }

            joystickStick.style.transform = `translate(calc(-50% + ${dx}px), calc(-50% + ${dy}px))`;
            joystick.vx = dx / maxR;
            joystick.vz = dy / maxR;
        }

        function resetJoystick() {
            joystick.active = false;
            joystick.touchId = null;
            joystick.vx = 0;
            joystick.vz = 0;
            joystickStick.style.transform = 'translate(-50%, -50%)';
        }

        joystickBase.addEventListener('touchstart', (e) => {
            e.preventDefault();
            e.stopPropagation();
            sound.init();
            const touch = e.changedTouches[0];
            joystick.active = true;
            joystick.touchId = touch.identifier;
            handleJoystickMove(touch.clientX, touch.clientY);
        }, { passive: false });

        joystickBase.addEventListener('touchmove', (e) => {
            e.preventDefault();
            e.stopPropagation();
            for (let i = 0; i < e.changedTouches.length; i++) {
                if (e.changedTouches[i].identifier === joystick.touchId) {
                    handleJoystickMove(e.changedTouches[i].clientX, e.changedTouches[i].clientY);
                    break;
                }
            }
        }, { passive: false });

        joystickBase.addEventListener('touchend', (e) => {
            e.preventDefault();
            e.stopPropagation();
            for (let i = 0; i < e.changedTouches.length; i++) {
                if (e.changedTouches[i].identifier === joystick.touchId) {
                    resetJoystick();
                    break;
                }
            }
        }, { passive: false });

        // Mouse support on Virtual Thumbstick for desktop testing
        joystickBase.addEventListener('mousedown', (e) => {
            e.stopPropagation();
            sound.init();
            joystick.active = true;
            handleJoystickMove(e.clientX, e.clientY);
        });
        window.addEventListener('mousemove', (e) => {
            if (joystick.active && joystick.touchId === null) {
                handleJoystickMove(e.clientX, e.clientY);
            }
        });
        window.addEventListener('mouseup', () => {
            if (joystick.active && joystick.touchId === null) {
                resetJoystick();
            }
        });

        // Tactile On-Screen Right Action Pad
        document.getElementById('touch-btn-cam').addEventListener('click', (e) => {
            e.stopPropagation();
            Haptics.hit();
            cycleCameraMode();
        });
        document.getElementById('touch-btn-emp').addEventListener('click', (e) => {
            e.stopPropagation();
            triggerNovaBomb();
        });
        document.getElementById('touch-btn-fire').addEventListener('click', (e) => {
            e.stopPropagation();
            Haptics.hit();
            state.autoFire = !state.autoFire;
            document.getElementById('text-autofire').textContent = `AUTOFIRE: ${state.autoFire ? 'ON' : 'OFF'}`;
            document.getElementById('touch-fire-label').textContent = state.autoFire ? 'AUTO' : 'FIRE';
            showAppToast(`AUTOFIRE: ${state.autoFire ? 'LOCKED ON' : 'MANUAL'}`);
        });

        // Fullscreen App Mode Toggle
        document.getElementById('btn-fullscreen').addEventListener('click', () => {
            if (!document.fullscreenElement) {
                document.documentElement.requestFullscreen().catch(() => {});
                document.getElementById('icon-fullscreen').className = 'fa-solid fa-compress';
            } else {
                document.exitFullscreen().catch(() => {});
                document.getElementById('icon-fullscreen').className = 'fa-solid fa-expand';
            }
        });

        // Settings Drawer Modal Controls
        const settingsModal = document.getElementById('settings-modal');
        document.getElementById('btn-settings').addEventListener('click', () => {
            if (state.mode === 'PLAYING') togglePause();
            settingsModal.classList.remove('hidden');
        });
        document.getElementById('btn-close-settings').addEventListener('click', () => settingsModal.classList.add('hidden'));
        document.getElementById('btn-save-settings').addEventListener('click', () => {
            settingsModal.classList.add('hidden');
            showAppToast('SETTINGS UPDATED');
        });

        document.getElementById('setting-volume').addEventListener('input', (e) => {
            const pct = parseInt(e.target.value, 10);
            document.getElementById('setting-vol-label').textContent = `${pct}%`;
            sound.setVolume(pct / 100);
        });

        document.getElementById('setting-control-mode').addEventListener('click', (e) => {
            const modes = ['BOTH', 'JOYSTICK', 'DRAG'];
            const labels = { BOTH: 'JOYSTICK + DRAG', JOYSTICK: 'THUMBSTICK ONLY', DRAG: 'TOUCH DRAG ONLY' };
            const nextIdx = (modes.indexOf(appSettings.controlMode) + 1) % modes.length;
            appSettings.controlMode = modes[nextIdx];
            e.currentTarget.textContent = labels[appSettings.controlMode];
            joystickContainer.style.display = appSettings.controlMode === 'DRAG' ? 'none' : 'flex';
        });

        document.getElementById('setting-haptics').addEventListener('click', (e) => {
            appSettings.haptics = !appSettings.haptics;
            e.currentTarget.textContent = `HAPTICS: ${appSettings.haptics ? 'ON' : 'OFF'}`;
            if (appSettings.haptics) Haptics.hit();
        });

        document.getElementById('setting-graphics').addEventListener('click', (e) => {
            appSettings.graphicsUltra = !appSettings.graphicsUltra;
            e.currentTarget.textContent = appSettings.graphicsUltra ? 'ULTRA (HD)' : 'BALANCED (60FPS)';
            if (renderer) {
                renderer.setPixelRatio(appSettings.graphicsUltra ? Math.min(window.devicePixelRatio, 2) : 1);
            }
        });

        // Install Native PWA / APK Guide Modal Controls
        const installModal = document.getElementById('install-modal');
        document.getElementById('btn-install-app').addEventListener('click', () => {
            if (state.mode === 'PLAYING') togglePause();
            installModal.classList.remove('hidden');
        });
        document.getElementById('btn-close-install').addEventListener('click', () => installModal.classList.add('hidden'));
        document.getElementById('btn-done-install').addEventListener('click', () => installModal.classList.add('hidden'));

        document.getElementById('btn-trigger-pwa-install').addEventListener('click', async () => {
            if (deferredInstallPrompt) {
                deferredInstallPrompt.prompt();
                const { outcome } = await deferredInstallPrompt.userChoice;
                if (outcome === 'accepted') {
                    showAppToast('NOVA STRIKE 3D INSTALLED!');
                    installModal.classList.add('hidden');
                }
                deferredInstallPrompt = null;
            } else {
                showAppToast('USE BROWSER MENU -> ADD TO HOME SCREEN');
            }
        });

        // --- 11. ANIMATION LOOP ---
        let lastTime = performance.now();
        function gameLoop(now) {
            const dt = Math.min(0.05, (now - lastTime) / 1000);
            lastTime = now;

            updateGame(dt);
            renderer.render(scene, camera);

            requestAnimationFrame(gameLoop);
        }

        window.onload = function () {
            bootstrapPWA();
            resizeCanvas();
            initThreeJS();
            player = new Player3D();
            updateHUD();
            requestAnimationFrame(gameLoop);
        };
    </script>
</body>
</html>
