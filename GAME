        // --- 5. PLAYER 3D CLASS ---
        class Player3D {
            constructor() {
                this.radius = 2.6;
                this.x = 0;
                this.y = 0;
                this.z = 24;
                this.speed = 46;
                this.maxShields = 4;
                this.shields = 4;
                this.bombs = 2;
                this.weaponLevel = 1;
                this.fireCooldown = 0;
                this.invulnTimer = 0;
                this.bankAngle = 0;
                this.pitchAngle = 0;

                this.mesh = buildPlayerShipMesh();
                this.mesh.position.set(this.x, this.y, this.z);
                scene.add(this.mesh);
            }

            destroy() {
                if (this.mesh) {
                    scene.remove(this.mesh);
                    this.mesh = null;
                }
            }

            update(dt) {
                let dx = 0;
                let dz = 0;

                if (keys.ArrowLeft || keys.KeyA) dx -= 1;
                if (keys.ArrowRight || keys.KeyD) dx += 1;
                if (keys.ArrowUp || keys.KeyW) dz -= 1;
                if (keys.ArrowDown || keys.KeyS) dz += 1;

                if (joystick.active) {
                    dx = joystick.vx;
                    dz = joystick.vz;
                    this.x += dx * this.speed * dt;
                    this.z += dz * this.speed * dt;

                    const targetBank = -dx * 0.62;
                    const targetPitch = -dz * 0.25;
                    this.bankAngle += (targetBank - this.bankAngle) * Math.min(1, dt * 14);
                    this.pitchAngle += (targetPitch - this.pitchAngle) * Math.min(1, dt * 14);
                } else if (pointer.active && appSettings.controlMode !== 'JOYSTICK') {
                    const diffX = pointer.worldX - this.x;
                    const diffZ = pointer.worldZ - this.z;
                    this.x += diffX * Math.min(1, dt * 12);
                    this.z += diffZ * Math.min(1, dt * 12);
                    this.bankAngle = Math.max(-0.65, Math.min(0.65, -diffX * 0.08));
                    this.pitchAngle = Math.max(-0.3, Math.min(0.3, -diffZ * 0.04));
                } else {
                    if (dx !== 0 && dz !== 0) {
                        const inv = 1 / Math.hypot(dx, dz);
                        dx *= inv;
                        dz *= inv;
                    }
                    this.x += dx * this.speed * dt;
                    this.z += dz * this.speed * dt;

                    const targetBank = -dx * 0.58;
                    const targetPitch = -dz * 0.22;
                    this.bankAngle += (targetBank - this.bankAngle) * Math.min(1, dt * 12);
                    this.pitchAngle += (targetPitch - this.pitchAngle) * Math.min(1, dt * 12);
                }

                // Clamp within 3D Arena
                this.x = Math.max(-WORLD.xBound, Math.min(WORLD.xBound, this.x));
                this.z = Math.max(WORLD.zMin, Math.min(WORLD.zMax, this.z));

                // Subtle 3D hover oscillation
                this.y = Math.sin(performance.now() * 0.005) * 0.35;

                // Apply 3D Transform & Banking/Pitching
                this.mesh.position.set(this.x, this.y, this.z);
                this.mesh.rotation.z = this.bankAngle;
                this.mesh.rotation.x = this.pitchAngle;

                // Update dynamic point light
                playerLight.position.set(this.x, this.y + 3, this.z);

                // Animate Thruster Cones & Energy Shield
                const { leftFlame, rightFlame, shieldMesh, shieldMat } = this.mesh.userData;
                const flicker = 0.8 + Math.random() * 0.65;
                leftFlame.scale.set(1, 1, flicker);
                rightFlame.scale.set(1, 1, flicker);

                shieldMesh.rotation.y += dt * 1.5;
                shieldMesh.rotation.x += dt * 0.8;

                if (this.invulnTimer > 0) {
                    this.invulnTimer -= dt;
                    shieldMat.opacity = 0.35 + Math.sin(performance.now() * 0.03) * 0.25;
                } else {
                    shieldMat.opacity = 0.1;
                }

                // Spawn 3D Thruster Exhaust Particles
                if (Math.random() < 0.7) {
                    spawn3DParticle(
                        this.x + (Math.random() - 0.5) * 1.6,
                        this.y,
                        this.z + 4.4,
                        (Math.random() - 0.5) * 4,
                        (Math.random() - 0.5) * 4,
                        32 + Math.random() * 18,
                        0x00f3ff,
                        0.22,
                        0.32
                    );
                }

                // Weapon Firing
                this.fireCooldown -= dt;
                if ((state.autoFire || keys.Space || pointer.active) && this.fireCooldown <= 0) {
                    this.shoot();
                }
            }

            shoot() {
                sound.playLaser(this.weaponLevel);

                if (this.weaponLevel === 1) {
                    this.fireCooldown = 0.16;
                    this.spawnLaser(this.x - 2.2, this.z - 2.0, 0, -135, 0x00f3ff, 1);
                    this.spawnLaser(this.x + 2.2, this.z - 2.0, 0, -135, 0x00f3ff, 1);
                } else if (this.weaponLevel === 2) {
                    this.fireCooldown = 0.16;
                    this.spawnLaser(this.x, this.z - 2.8, 0, -145, 0x00f3ff, 1.25);
                    this.spawnLaser(this.x - 2.4, this.z - 1.8, -26, -138, 0x39ff14, 1);
                    this.spawnLaser(this.x + 2.4, this.z - 1.8, 26, -138, 0x39ff14, 1);
                } else if (this.weaponLevel === 3) {
                    this.fireCooldown = 0.10;
                    this.spawnLaser(this.x - 2.4, this.z - 2.2, 0, -160, 0xff007f, 1.4);
                    this.spawnLaser(this.x + 2.4, this.z - 2.2, 0, -160, 0xff007f, 1.4);
                } else {
                    // Level 4: 5-Way Hyper Overdrive
                    this.fireCooldown = 0.13;
                    const angles = [-0.30, -0.15, 0, 0.15, 0.30];
                    angles.forEach(ang => {
                        this.spawnLaser(
                            this.x,
                            this.z - 2.4,
                            Math.sin(ang) * 150,
                            -Math.cos(ang) * 150,
                            Math.abs(ang) < 0.08 ? 0xffbe0b : 0x00f3ff,
                            1.3
                        );
                    });
                }
            }

            spawnLaser(x, z, vx, vz, colorHex, dmg) {
                const geo = new THREE.CylinderGeometry(0.24, 0.24, 3.6, 6);
                geo.rotateX(Math.PI / 2);
                const mat = new THREE.MeshBasicMaterial({ color: colorHex });
                const mesh = new THREE.Mesh(geo, mat);
                mesh.position.set(x, this.y, z);
                mesh.rotation.y = Math.atan2(-vx, -vz);
                scene.add(mesh);

                bullets.push({
                    mesh,
                    x,
                    y: this.y,
                    z,
                    vx,
                    vz,
                    dmg,
                    radius: 1.0
                });
            }
        }

