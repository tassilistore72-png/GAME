            showAppToast._timer = setTimeout(() => toast.classList.add('hidden'), 2400);
        }

        function bootstrapPWA() {
            try {
                // 1. Dynamically render a 512x512 Neon Starfighter App Icon
                const iconCanvas = document.createElement('canvas');
                iconCanvas.width = 512;
                iconCanvas.height = 512;
                const ictx = iconCanvas.getContext('2d');

                // Deep space background with rounded glow border
                const bgGrad = ictx.createRadialGradient(256, 256, 40, 256, 256, 260);
                bgGrad.addColorStop(0, '#141b42');
                bgGrad.addColorStop(1, '#050714');
                ictx.fillStyle = bgGrad;
                ictx.fillRect(0, 0, 512, 512);

                // Cyber grid lines
                ictx.strokeStyle = 'rgba(0, 243, 255, 0.18)';
                ictx.lineWidth = 3;
                for (let i = 64; i < 512; i += 64) {
                    ictx.beginPath(); ictx.moveTo(i, 0); ictx.lineTo(i, 512); ictx.stroke();
                    ictx.beginPath(); ictx.moveTo(0, i); ictx.lineTo(512, i); ictx.stroke();
                }

                // Glowing Outer Ring
                ictx.strokeStyle = '#00f3ff';
                ictx.lineWidth = 12;
                ictx.shadowColor = '#00f3ff';
                ictx.shadowBlur = 24;
                ictx.strokeRect(22, 22, 468, 468);

                // Neon Starfighter Silhouette
                ictx.fillStyle = '#00f3ff';
                ictx.beginPath();
                ictx.moveTo(256, 76);
                ictx.lineTo(396, 384);
                ictx.lineTo(256, 326);
                ictx.lineTo(116, 384);
                ictx.closePath();
                ictx.fill();

                // Magenta Core Canopy
                ictx.fillStyle = '#ff007f';
                ictx.shadowColor = '#ff007f';
                ictx.beginPath();
                ictx.moveTo(256, 148);
                ictx.lineTo(296, 290);
                ictx.lineTo(256, 268);
                ictx.lineTo(216, 290);
                ictx.closePath();
                ictx.fill();

                const iconDataUrl = iconCanvas.toDataURL('image/png');

                // Set preview image & inject <link rel="icon"> and <link rel="apple-touch-icon">
                const previewImg = document.getElementById('app-icon-preview');
                if (previewImg) previewImg.src = iconDataUrl;

                const appleIcon = document.createElement('link');
                appleIcon.rel = 'apple-touch-icon';
                appleIcon.href = iconDataUrl;
                document.head.appendChild(appleIcon);

                const favIcon = document.createElement('link');
                favIcon.rel = 'icon';
                favIcon.type = 'image/png';
                favIcon.href = iconDataUrl;
                document.head.appendChild(favIcon);

                // 2. Dynamically build and inject Web App Manifest via Blob
                const manifestObj = {
                    name: 'Nova Strike: Neon Overdrive 3D',
                    short_name: 'NovaStrike3D',
                    description: '3D WebGL Neon Space Shooter Arcade App',
                    start_url: window.location.href,
                    display: 'standalone',
                    orientation: 'any',
                    background_color: '#050714',
                    theme_color: '#050714',
                    categories: ['games', 'arcade', 'action'],
                    icons: [
                        { src: iconDataUrl, sizes: '512x512', type: 'image/png', purpose: 'any maskable' }
                    ]
                };
                const manifestBlob = new Blob([JSON.stringify(manifestObj)], { type: 'application/manifest+json' });
                const manifestLink = document.createElement('link');
                manifestLink.rel = 'manifest';
                manifestLink.href = URL.createObjectURL(manifestBlob);
                document.head.appendChild(manifestLink);

                // 3. Register lightweight offline-ready Service Worker where permitted
                if ('serviceWorker' in navigator && (window.location.protocol === 'https:' || window.location.hostname === 'localhost')) {
                    const swCode = `
                        self.addEventListener('install', e => self.skipWaiting());
                        self.addEventListener('activate', e => e.waitUntil(self.clients.claim()));
                        self.addEventListener('fetch', e => {});
                    `;
                    const swBlob = new Blob([swCode], { type: 'application/javascript' });
                    navigator.serviceWorker.register(URL.createObjectURL(swBlob)).catch(() => {});
                }
            } catch (err) {}
        }

        window.addEventListener('beforeinstallprompt', (e) => {
