        // --- 1. WEB AUDIO API SOUND SYNTHESIZER ---
        class SoundEngine {
            constructor() {
                this.ctx = null;
                this.masterGain = null;
                this.enabled = true;
            }

            init() {
                if (!this.ctx) {
                    const AudioCtx = window.AudioContext || window.webkitAudioContext;
                    if (AudioCtx) {
                        this.ctx = new AudioCtx();
                        this.masterGain = this.ctx.createGain();
                        this.masterGain.gain.value = appSettings.volume;
                        this.masterGain.connect(this.ctx.destination);
                    }
                }
                if (this.ctx && this.ctx.state === 'suspended') {
                    this.ctx.resume();
                }
            }

            setVolume(val) {
                appSettings.volume = Math.max(0, Math.min(1, val));
                if (this.masterGain && this.ctx) {
                    this.masterGain.gain.setValueAtTime(appSettings.volume, this.ctx.currentTime);
                }
            }

            get dest() {
                return this.masterGain || (this.ctx && this.ctx.destination);
            }

            toggle() {
                this.enabled = !this.enabled;
                if (this.enabled) this.init();
                return this.enabled;
            }

            playLaser(weaponType = 1) {
                if (!this.enabled || !this.ctx) return;
                try {
                    const now = this.ctx.currentTime;
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();

                    osc.type = weaponType >= 3 ? 'sawtooth' : 'triangle';
                    const startFreq = weaponType === 2 ? 980 : 760;
                    osc.frequency.setValueAtTime(startFreq, now);
                    osc.frequency.exponentialRampToValueAtTime(140, now + 0.09);

                    gain.gain.setValueAtTime(0.10, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.09);

                    osc.connect(gain);
                    gain.connect(this.dest);

                    osc.start(now);
                    osc.stop(now + 0.09);
                } catch (e) {}
            }

            playHit() {
                if (!this.enabled || !this.ctx) return;
                try {
                    const now = this.ctx.currentTime;
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();

                    osc.type = 'square';
                    osc.frequency.setValueAtTime(340, now);
                    osc.frequency.exponentialRampToValueAtTime(110, now + 0.05);

                    gain.gain.setValueAtTime(0.08, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.05);

                    osc.connect(gain);
                    gain.connect(this.dest);

                    osc.start(now);
                    osc.stop(now + 0.05);
                } catch (e) {}
            }

            playExplosion(isLarge = false) {
                if (!this.enabled || !this.ctx) return;
                try {
                    const now = this.ctx.currentTime;
                    const duration = isLarge ? 0.5 : 0.24;

                    const bufferSize = this.ctx.sampleRate * duration;
                    const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
                    const data = buffer.getChannelData(0);
                    for (let i = 0; i < bufferSize; i++) {
                        data[i] = Math.random() * 2 - 1;
                    }

                    const noise = this.ctx.createBufferSource();
                    noise.buffer = buffer;

                    const filter = this.ctx.createBiquadFilter();
                    filter.type = 'lowpass';
                    filter.frequency.setValueAtTime(isLarge ? 980 : 680, now);
                    filter.frequency.exponentialRampToValueAtTime(55, now + duration);

                    const gain = this.ctx.createGain();
                    gain.gain.setValueAtTime(isLarge ? 0.28 : 0.16, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + duration);

                    noise.connect(filter);
                    filter.connect(gain);
                    gain.connect(this.dest);

                    noise.start(now);
                    noise.stop(now + duration);
                } catch (e) {}
            }

            playPowerUp() {
                if (!this.enabled || !this.ctx) return;
                try {
                    const now = this.ctx.currentTime;
                    const notes = [523.25, 659.25, 783.99, 1046.50];
                    notes.forEach((freq, idx) => {
                        const osc = this.ctx.createOscillator();
                        const gain = this.ctx.createGain();
                        osc.type = 'sine';
                        osc.frequency.setValueAtTime(freq, now + idx * 0.055);

                        gain.gain.setValueAtTime(0.14, now + idx * 0.055);
                        gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.055 + 0.15);

                        osc.connect(gain);
                        gain.connect(this.dest);
                        osc.start(now + idx * 0.055);
                        osc.stop(now + idx * 0.055 + 0.15);
                    });
                } catch (e) {}
            }

            playNovaBomb() {
                if (!this.enabled || !this.ctx) return;
                try {
                    const now = this.ctx.currentTime;
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(460, now);
                    osc.frequency.exponentialRampToValueAtTime(32, now + 0.7);

                    gain.gain.setValueAtTime(0.3, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.7);

                    osc.connect(gain);
                    gain.connect(this.dest);
                    osc.start(now);
                    osc.stop(now + 0.7);
                    this.playExplosion(true);
                } catch (e) {}
            }

            playGameOver() {
                if (!this.enabled || !this.ctx) return;
                try {
                    const now = this.ctx.currentTime;
                    const freqs = [392.00, 349.23, 311.13, 261.63];
                    freqs.forEach((f, i) => {
                        const osc = this.ctx.createOscillator();
                        const gain = this.ctx.createGain();
                        osc.type = 'sawtooth';
                        osc.frequency.setValueAtTime(f, now + i * 0.14);

                        gain.gain.setValueAtTime(0.15, now + i * 0.14);
                        gain.gain.exponentialRampToValueAtTime(0.001, now + i * 0.14 + 0.25);

                        osc.connect(gain);
                        gain.connect(this.dest);
                        osc.start(now + i * 0.14);
                        osc.stop(now + i * 0.14 + 0.25);
                    });
                } catch (e) {}
            }
        }

