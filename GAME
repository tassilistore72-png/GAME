            // Side Neon Boundary Pillars / Cyber Arches
            const pillarGeo = new THREE.BoxGeometry(0.8, 18, 0.8);
            const pillarMatL = new THREE.MeshBasicMaterial({ color: 0x00f3ff, wireframe: false });
            const pillarMatR = new THREE.MeshBasicMaterial({ color: 0xff007f, wireframe: false });

            for (let i = 0; i < 10; i++) {
