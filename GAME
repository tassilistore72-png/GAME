<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <meta name="theme-color" content="#050714">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Nova Strike 3D">
    <meta name="application-name" content="Nova Strike 3D">
    <title>NOVA STRIKE 3D // Neon WebGL Space Shooter App</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Three.js r128 WebGL Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <!-- Google Fonts: Orbitron & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Orbitron:wght@600;800;900&display=swap" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
        :root {
            --neon-cyan: #00f3ff;
            --neon-magenta: #ff007f;
            --neon-lime: #39ff14;
            --neon-amber: #ffbe0b;
            --bg-dark: #060713;
        }

        * {
            box-sizing: border-box;
            user-select: none;
            -webkit-user-select: none;
            -webkit-touch-callout: none;
        }

        body {
            margin: 0;
            padding: 0;
            background: radial-gradient(circle at 50% 20%, #131633 0%, #060713 75%);
            color: #f8fafc;
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .font-arcade {
            font-family: 'Orbitron', sans-serif;
            letter-spacing: 0.06em;
        }

        /* Neon Glow Utilities */
        .glow-cyan {
            text-shadow: 0 0 10px rgba(0, 243, 255, 0.8), 0 0 22px rgba(0, 243, 255, 0.4);
        }
        .glow-magenta {
            text-shadow: 0 0 10px rgba(255, 0, 127, 0.8), 0 0 22px rgba(255, 0, 127, 0.4);
        }
        .glow-amber {
            text-shadow: 0 0 10px rgba(255, 190, 11, 0.8), 0 0 22px rgba(255, 190, 11, 0.4);
        }

        /* Arcade Cabinet Frame */
        .arcade-frame {
            position: relative;
            background: #05060f;
            border: 2px solid rgba(0, 243, 255, 0.45);
            box-shadow:
                0 0 25px rgba(0, 243, 255, 0.2),
                inset 0 0 30px rgba(0, 243, 255, 0.12);
            border-radius: 1rem;
            overflow: hidden;
        }

        /* Subtle CRT scanline overlay */
        .scanlines::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(
                rgba(18, 16, 16, 0) 50%, 
                rgba(0, 0, 0, 0.22) 50%
            );
            background-size: 100% 4px;
            pointer-events: none;
            z-index: 15;
            opacity: 0.45;
        }

        canvas {
            display: block;
            width: 100%;
            height: 100%;
            touch-action: none;
            cursor: crosshair;
        }

        /* Custom Arcade Buttons */
        .arcade-btn {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            font-family: 'Orbitron', sans-serif;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            border-radius: 0.75rem;
            transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
            cursor: pointer;
            outline: none;
        }

        .arcade-btn-cyan {
            background: linear-gradient(180deg, rgba(0, 243, 255, 0.22) 0%, rgba(0, 140, 255, 0.12) 100%);
            border: 1.5px solid rgba(0, 243, 255, 0.65);
            color: #e0faff;
            box-shadow: 0 4px 0 #005b7f, 0 0 15px rgba(0, 243, 255, 0.25);
        }
        .arcade-btn-cyan:hover {
            background: linear-gradient(180deg, rgba(0, 243, 255, 0.35) 0%, rgba(0, 140, 255, 0.22) 100%);
            box-shadow: 0 4px 0 #0077a3, 0 0 22px rgba(0, 243, 255, 0.5);
            transform: translateY(-1px);
        }
        .arcade-btn-cyan:active {
            transform: translateY(3px);
            box-shadow: 0 1px 0 #005b7f, 0 0 10px rgba(0, 243, 255, 0.3);
        }

        .arcade-btn-magenta {
            background: linear-gradient(180deg, rgba(255, 0, 127, 0.25) 0%, rgba(180, 0, 90, 0.14) 100%);
            border: 1.5px solid rgba(255, 0, 127, 0.65);
            color: #ffe0f0;
            box-shadow: 0 4px 0 #7a003d, 0 0 15px rgba(255, 0, 127, 0.25);
        }
        .arcade-btn-magenta:hover {
            background: linear-gradient(180deg, rgba(255, 0, 127, 0.4) 0%, rgba(180, 0, 90, 0.24) 100%);
            box-shadow: 0 4px 0 #9e004f, 0 0 22px rgba(255, 0, 127, 0.5);
            transform: translateY(-1px);
        }
        .arcade-btn-magenta:active {
            transform: translateY(3px);
            box-shadow: 0 1px 0 #7a003d, 0 0 10px rgba(255, 0, 127, 0.3);
        }

        .arcade-btn-amber {
            background: linear-gradient(180deg, rgba(255, 190, 11, 0.25) 0%, rgba(217, 119, 6, 0.14) 100%);
            border: 1.5px solid rgba(255, 190, 11, 0.65);
            color: #fef3c7;
            box-shadow: 0 4px 0 #78350f, 0 0 15px rgba(255, 190, 11, 0.25);
        }
        .arcade-btn-amber:hover {
            background: linear-gradient(180deg, rgba(255, 190, 11, 0.38) 0%, rgba(217, 119, 6, 0.24) 100%);
            box-shadow: 0 4px 0 #92400e, 0 0 22px rgba(255, 190, 11, 0.5);
            transform: translateY(-1px);
        }
        .arcade-btn-amber:active {
            transform: translateY(3px);
            box-shadow: 0 1px 0 #78350f, 0 0 10px rgba(255, 190, 11, 0.3);
        }

        /* HUD Stat Pill */
        .hud-card {
            background: rgba(11, 15, 34, 0.85);
            border: 1px solid rgba(0, 243, 255, 0.25);
            backdrop-filter: blur(8px);
            border-radius: 0.75rem;
        }

        @keyframes pulseSlow {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.82; transform: scale(1.03); }
        }
        .animate-pulse-slow {
            animation: pulseSlow 2.4s infinite ease-in-out;
        }

        /* Native App Virtual Thumbstick & Touch Controls */
        .joystick-base {
            width: 108px;
            height: 108px;
            border-radius: 9999px;
            background: radial-gradient(circle, rgba(0, 243, 255, 0.14) 0%, rgba(6, 7, 19, 0.78) 75%);
            border: 2px solid rgba(0, 243, 255, 0.45);
            box-shadow: 0 0 20px rgba(0, 243, 255, 0.2), inset 0 0 15px rgba(0, 243, 255, 0.15);
            position: relative;
            touch-action: none;
        }

        .joystick-stick {
            width: 46px;
            height: 46px;
            border-radius: 9999px;
            background: radial-gradient(circle at 35% 35%, #e0faff 0%, #00f3ff 45%, #006699 100%);
            border: 2px solid #ffffff;
            box-shadow: 0 0 16px rgba(0, 243, 255, 0.85);
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            transition: transform 0.04s linear;
            pointer-events: none;
        }

        .touch-action-btn {
            width: 58px;
            height: 58px;
            border-radius: 9999px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            font-family: 'Orbitron', sans-serif;
            font-weight: 800;
            font-size: 9px;
            letter-spacing: 0.04em;
            backdrop-filter: blur(6px);
            touch-action: none;
            transition: transform 0.1s ease, box-shadow 0.1s ease;
        }
        .touch-action-btn:active {
            transform: scale(0.90);
        }

        /* Range Slider Styling */
        input[type="range"].cyber-slider {
            -webkit-appearance: none;
            appearance: none;
            width: 100%;
            height: 8px;
            background: #0f172a;
            border-radius: 999px;
            border: 1px solid rgba(0, 243, 255, 0.4);
            outline: none;
        }
        input[type="range"].cyber-slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: #00f3ff;
            box-shadow: 0 0 10px #00f3ff;
            cursor: pointer;
        }
    </style>
</head>
<body class="p-1.5 sm:p-3 md:p-5">

    <!-- Main App Wrapper -->
    <div class="w-full max-w-4xl flex flex-col items-center gap-3">

        <!-- TOP HUD BAR (Outside Canvas) -->
        <header class="w-full flex flex-wrap items-center justify-between gap-2 px-3 py-2.5 hud-card shadow-lg">
            <!-- Brand & Level -->
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-cyan-500/10 border border-cyan-400/50 flex items-center justify-center text-cyan-400 shadow-inner">
                    <i class="fa-solid fa-cube text-lg animate-spin" style="animation-duration: 8s;"></i>
                </div>
                <div>
                    <h1 class="font-arcade text-base sm:text-lg font-black tracking-wider text-cyan-300 glow-cyan leading-none">
                        NOVA STRIKE <span class="text-fuchsia-400">3D</span>
                    </h1>
                    <div class="flex items-center gap-2 mt-1">
                        <span id="hud-level" class="text-xs font-arcade font-bold px-2 py-0.5 rounded bg-fuchsia-500/20 border border-fuchsia-400/40 text-fuchsia-300">
                            SECTOR 01
                        </span>
                        <span id="hud-weapon" class="text-[11px] font-semibold text-amber-300 bg-amber-500/10 border border-amber-400/30 px-2 py-0.5 rounded">
                            PULSE MK-I
                        </span>
                    </div>
                </div>
            </div>

            <!-- Score / Combo / High Score -->
            <div class="flex items-center gap-3 sm:gap-6">
                <div class="text-right">
                    <div class="text-[10px] uppercase tracking-widest text-slate-400 font-semibold">Score</div>
                    <div id="hud-score" class="font-arcade text-lg sm:text-2xl font-extrabold text-white glow-cyan">000000</div>
                </div>

                <div class="text-center px-2.5 py-1 rounded-lg bg-slate-900/90 border border-amber-400/30">
                    <div class="text-[10px] uppercase tracking-widest text-amber-300/80 font-semibold">Combo</div>
                    <div id="hud-combo" class="font-arcade text-sm sm:text-lg font-black text-amber-400 glow-amber">1.0x</div>
                </div>

                <div class="text-right">
                    <div class="text-[10px] uppercase tracking-widest text-fuchsia-300/80 font-semibold">Best</div>
                    <div id="hud-highscore" class="font-arcade text-lg sm:text-2xl font-extrabold text-fuchsia-400 glow-magenta">000000</div>
                </div>
            </div>

            <!-- Shield / Lives & Nova Bomb Bar -->
            <div class="w-full sm:w-auto flex items-center justify-between sm:justify-end gap-4 pt-1 sm:pt-0 border-t sm:border-t-0 border-slate-800">
                <!-- Hull Integrity -->
                <div class="flex items-center gap-2">
                    <span class="text-xs font-arcade text-cyan-300"><i class="fa-solid fa-shield-halved mr-1"></i>HULL</span>
                    <div id="hud-shields" class="flex items-center gap-1">
                        <!-- Dynamically populated shield bars -->
                    </div>
                </div>
                <!-- Nova Bombs -->
                <div class="flex items-center gap-1.5" title="Press SHIFT or B to trigger EMP Nova Bomb">
                    <span class="text-xs font-arcade text-amber-300"><i class="fa-solid fa-burst mr-1"></i>NOVA</span>
                    <div id="hud-bombs" class="flex items-center gap-1 text-amber-400">
                        <!-- Dynamically populated bomb icons -->
                    </div>
                </div>

                <!-- Native App Utility Actions (Install, Settings, Fullscreen) -->
                <div class="flex items-center gap-1.5 pl-2 border-l border-slate-800">
                    <button id="btn-install-app" class="arcade-btn arcade-btn-amber px-2.5 py-1.5 text-[11px]" title="Install App to Home Screen or Desktop">
                        <i class="fa-solid fa-download"></i>
                        <span class="hidden md:inline">INSTALL APP</span>
                    </button>
                    <button id="btn-settings" class="arcade-btn arcade-btn-cyan px-2.5 py-1.5 text-xs" title="App Settings & Controls">
                        <i class="fa-solid fa-sliders"></i>
                    </button>
                    <button id="btn-fullscreen" class="arcade-btn arcade-btn-cyan px-2.5 py-1.5 text-xs" title="Toggle Fullscreen App Mode">
                        <i id="icon-fullscreen" class="fa-solid fa-expand"></i>
                    </button>
                </div>
            </div>
        </header>

        <!-- GAME CANVAS CONTAINER -->
        <main id="canvas-wrapper" class="w-full arcade-frame scanlines relative aspect-[4/3] sm:aspect-[16/10] max-h-[68vh]">
            <canvas id="gameCanvas"></canvas>

            <!-- 2D Floating Combat Text Overlay (Projected from 3D World Space) -->
            <div id="floating-text-layer" class="absolute inset-0 pointer-events-none overflow-hidden z-10"></div>

            <!-- Camera Angle Hint Pill -->
            <div class="absolute bottom-2.5 right-3 z-10 pointer-events-none hidden sm:flex items-center gap-2 px-2.5 py-1 rounded-full bg-slate-950/75 border border-cyan-500/30 text-[10px] font-arcade text-cyan-300/80">
                <i class="fa-solid fa-video"></i>
                <span id="hud-cam-label">CAM: CHASE 3D (DRAG RIGHT-CLICK OR PRESS C)</span>
            </div>

            <!-- Boss Health Bar Overlay (Hidden unless Boss is active) -->
            <div id="boss-hud" class="hidden absolute top-3 left-1/2 -translate-x-1/2 w-11/12 max-w-md z-20 pointer-events-none">
                <div class="flex justify-between items-center text-xs font-arcade text-rose-400 mb-1 px-1">
                    <span id="boss-name"><i class="fa-solid fa-skull-crossbones mr-1"></i>DREADNOUGHT CORE</span>
                    <span id="boss-hp-text">100%</span>
                </div>
                <div class="w-full h-3 bg-slate-950/90 rounded-full border border-rose-500/60 p-0.5 overflow-hidden shadow-lg">
                    <div id="boss-hp-bar" class="h-full bg-gradient-to-r from-rose-600 via-fuchsia-500 to-amber-400 rounded-full transition-all duration-100" style="width: 100%;"></div>
                </div>
            </div>

            <!-- Banner Notification Overlay (Sector Clear / Boss Incoming) -->
            <div id="sector-banner" class="hidden absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 z-20 pointer-events-none text-center w-full px-4">
                <div id="sector-banner-title" class="font-arcade text-2xl sm:text-4xl font-black text-cyan-300 glow-cyan tracking-widest uppercase">
                    SECTOR 02
                </div>
                <div id="sector-banner-sub" class="font-arcade text-xs sm:text-sm text-amber-300 tracking-wider mt-1 uppercase">
                    ENEMY SWARM APPROACHING
                </div>
            </div>

            <!-- START / PAUSE / GAME OVER MODAL OVERLAY -->
            <div id="modal-overlay" class="absolute inset-0 z-30 flex items-center justify-center bg-slate-950/80 backdrop-blur-md p-4 transition-opacity duration-200">
                <div class="max-w-md w-full hud-card p-6 sm:p-8 text-center border-2 border-cyan-400/50 shadow-2xl">
                    <div id="modal-badge" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-arcade bg-cyan-500/15 border border-cyan-400/40 text-cyan-300 mb-3">
                        <i class="fa-solid fa-cubes"></i> 3D WEBGL OVERDRIVE EDITION
                    </div>

                    <h2 id="modal-title" class="font-arcade text-3xl sm:text-4xl font-black text-white glow-cyan mb-2">
                        NOVA STRIKE 3D
                    </h2>
                    <p id="modal-subtitle" class="text-slate-300 text-sm mb-5 leading-relaxed">
                        Pilot the 3D Neon Interceptor across the cyber-grid. Bank through plasma barrages, collect 3D weapon holocrons, and shatter Sector Dreadnoughts!
                    </p>

                    <!-- Final Stats Box (Shown on Game Over) -->
                    <div id="modal-stats" class="hidden grid grid-cols-2 gap-3 mb-6 p-3 rounded-xl bg-slate-900/90 border border-slate-800">
                        <div>
                            <div class="text-[11px] uppercase text-slate-400">Final Score</div>
                            <div id="stat-final-score" class="font-arcade text-xl font-bold text-cyan-300">0</div>
                        </div>
                        <div>
                            <div class="text-[11px] uppercase text-slate-400">Sector Reached</div>
                            <div id="stat-final-level" class="font-arcade text-xl font-bold text-fuchsia-400">1</div>
                        </div>
                    </div>

                    <!-- Controls Guide Grid -->
                    <div class="grid grid-cols-2 gap-2.5 text-left text-xs bg-slate-900/75 p-3.5 rounded-xl border border-slate-800/90 mb-6">
                        <div class="flex items-center gap-2.5">
                            <span class="w-8 h-8 rounded-lg bg-cyan-500/15 border border-cyan-400/40 flex items-center justify-center text-cyan-300 shrink-0">
                                <i class="fa-solid fa-arrows-up-down-left-right"></i>
                            </span>
                            <div>
                                <div class="font-bold text-white">Move Ship</div>
                                <div class="text-slate-400 text-[11px]">WASD / Arrows / Touch</div>
                            </div>
                        </div>
                        <div class="flex items-center gap-2.5">
                            <span class="w-8 h-8 rounded-lg bg-fuchsia-500/15 border border-fuchsia-400/40 flex items-center justify-center text-fuchsia-300 shrink-0">
                                <i class="fa-solid fa-crosshairs"></i>
                            </span>
                            <div>
                                <div class="font-bold text-white">Blasters</div>
                                <div class="text-slate-400 text-[11px]">Space / Auto-Fire</div>
                            </div>
                        </div>
                        <div class="flex items-center gap-2.5">
                            <span class="w-8 h-8 rounded-lg bg-amber-500/15 border border-amber-400/40 flex items-center justify-center text-amber-300 shrink-0">
                                <i class="fa-solid fa-explosion"></i>
                            </span>
                            <div>
                                <div class="font-bold text-white">Nova EMP</div>
                                <div class="text-slate-400 text-[11px]">Shift / 'B' / Button</div>
                            </div>
                        </div>
                        <div class="flex items-center gap-2.5">
                            <span class="w-8 h-8 rounded-lg bg-lime-500/15 border border-lime-400/40 flex items-center justify-center text-lime-300 shrink-0">
                                <i class="fa-solid fa-video"></i>
                            </span>
                            <div>
                                <div class="font-bold text-white">3D Camera</div>
                                <div class="text-slate-400 text-[11px]">'C' Key / Right-Drag Orbit</div>
                            </div>
                        </div>
                    </div>

                    <div class="flex flex-col sm:flex-row gap-3 justify-center">
                        <button id="btn-modal-primary" class="arcade-btn arcade-btn-cyan px-6 py-3.5 text-sm sm:text-base w-full animate-pulse-slow">
                            <i class="fa-solid fa-play"></i> LAUNCH MISSION
                        </button>
                        <button id="btn-modal-restart" class="hidden arcade-btn arcade-btn-magenta px-5 py-3.5 text-sm sm:text-base w-full">
                            <i class="fa-solid fa-rotate-right"></i> NEW RUN
                        </button>
                    </div>
                </div>
            </div>

            <!-- NATIVE MOBILE VIRTUAL ANALOG THUMBSTICK & TACTILE ACTION PAD -->
            <div id="mobile-controls-layer" class="absolute inset-x-0 bottom-3 px-4 flex items-end justify-between pointer-events-none z-20">
                <!-- Left Virtual Analog Thumbstick -->
                <div id="joystick-container" class="pointer-events-auto flex flex-col items-center gap-1 opacity-85 hover:opacity-100 transition-opacity">
                    <div id="joystick-base" class="joystick-base">
                        <div id="joystick-stick" class="joystick-stick"></div>
                    </div>
                    <span class="text-[9px] font-arcade text-cyan-300/80 tracking-widest uppercase">3D THRUST</span>
                </div>

                <!-- Right Tactile Arcade Action Buttons -->
                <div class="pointer-events-auto flex items-end gap-2.5 opacity-90 hover:opacity-100 transition-opacity">
                    <button id="touch-btn-cam" class="touch-action-btn bg-cyan-500/20 border-2 border-cyan-400/70 text-cyan-200 shadow-[0_0_15px_rgba(0,243,255,0.3)]" title="Switch 3D Camera">
                        <i class="fa-solid fa-video text-sm mb-0.5"></i>
                        <span>CAM</span>
                    </button>
                    <button id="touch-btn-emp" class="touch-action-btn w-16 h-16 bg-amber-500/25 border-2 border-amber-400/80 text-amber-200 shadow-[0_0_18px_rgba(255,190,11,0.45)]" title="Detonate 3D Nova EMP">
                        <i class="fa-solid fa-burst text-base mb-0.5 text-amber-300"></i>
                        <span>EMP</span>
                    </button>
                    <button id="touch-btn-fire" class="touch-action-btn bg-fuchsia-500/25 border-2 border-fuchsia-400/80 text-fuchsia-200 shadow-[0_0_15px_rgba(255,0,127,0.35)]" title="Hold or Toggle Blasters">
                        <i class="fa-solid fa-crosshairs text-sm mb-0.5"></i>
                        <span id="touch-fire-label">AUTO</span>
                    </button>
                </div>
            </div>

            <!-- APP SETTINGS DRAWER MODAL -->
            <div id="settings-modal" class="hidden absolute inset-0 z-40 flex items-center justify-center bg-slate-950/85 backdrop-blur-md p-4">
                <div class="max-w-md w-full hud-card p-5 sm:p-6 border-2 border-cyan-400/50 shadow-2xl text-left">
                    <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-800">
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-sliders text-cyan-400"></i>
                            <h3 class="font-arcade text-lg font-black text-white glow-cyan">APP SETTINGS</h3>
                        </div>
                        <button id="btn-close-settings" class="w-8 h-8 rounded-lg bg-slate-900 border border-slate-700 text-slate-300 hover:text-white flex items-center justify-center">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>

                    <div class="space-y-4 text-xs sm:text-sm">
                        <!-- Master Synthesizer Volume -->
                        <div class="p-3 rounded-xl bg-slate-900/80 border border-slate-800">
                            <div class="flex justify-between items-center mb-2">
                                <span class="font-arcade text-cyan-300 text-xs"><i class="fa-solid fa-volume-high mr-1.5"></i>SYNTH VOLUME</span>
                                <span id="setting-vol-label" class="font-arcade text-white text-xs">85%</span>
                            </div>
                            <input id="setting-volume" type="range" min="0" max="100" value="85" class="cyber-slider">
                        </div>

                        <!-- Touch Control Scheme -->
                        <div class="flex items-center justify-between p-3 rounded-xl bg-slate-900/80 border border-slate-800">
