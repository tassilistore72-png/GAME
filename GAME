        function create3DExplosion(x, y, z, colorHex, count = 22, isLarge = false) {
            sound.playExplosion(isLarge);
            if (isLarge) state.screenShake = 1.6;

            // Flash dynamic 3D explosion point light
            explosionLight.color.setHex(colorHex);
            explosionLight.position.set(x, y + 4, z);
            explosionLight.intensity = isLarge ? 6.5 : 3.2;

            // Expanding 3D Shockwave Ring
            const ringGeo = new THREE.RingGeometry(0.5, isLarge ? 2.2 : 1.2, 24);
            ringGeo.rotateX(-Math.PI / 2);
            const ringMat = new THREE.MeshBasicMaterial({
                color: colorHex,
                side: THREE.DoubleSide,
                transparent: true,
                opacity: 0.9
            });
            const ringMesh = new THREE.Mesh(ringGeo, ringMat);
            ringMesh.position.set(x, y, z);
            scene.add(ringMesh);
            empShockwaves.push({
                mesh: ringMesh,
                rate: isLarge ? 42 : 22,
                life: 0.45,
                maxLife: 0.45
            });

            // Volumetric 3D Shards
            for (let i = 0; i < count; i++) {
                const theta = Math.random() * Math.PI * 2;
                const phi = (Math.random() - 0.5) * Math.PI;
                const speed = 12 + Math.random() * (isLarge ? 48 : 28);
                spawn3DParticle(
                    x,
                    y,
                    z,
                    Math.cos(theta) * Math.cos(phi) * speed,
                    Math.sin(phi) * speed,
                    Math.sin(theta) * Math.cos(phi) * speed,
                    colorHex,
                    0.35 + Math.random() * 0.45,
                    isLarge ? 0.95 : 0.6
                );
            }
        }

