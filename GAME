                leftP.position.set(-WORLD.xBound - 8, 1, 0);
                const rightP = new THREE.Mesh(pillarGeo, pillarMatR);
                rightP.position.set(WORLD.xBound + 8, 1, 0);

                pair.add(leftP);
                pair.add(rightP);
                pair.position.z = 40 - i * 24;
                scene.add(pair);
                cyberArches.push(pair);
            }

            // 3D Deep Space Volumetric Starfield
            const starCount = 550;
            starGeo = new THREE.BufferGeometry();
            const positions = new Float32Array(starCount * 3);
            const colors = new Float32Array(starCount * 3);

            for (let i = 0; i < starCount; i++) {
                positions[i * 3] = (Math.random() - 0.5) * 220;
                positions[i * 3 + 1] = (Math.random() - 0.3) * 90;
                positions[i * 3 + 2] = -Math.random() * 260 + 50;

                const c = Math.random() > 0.25
                    ? new THREE.Color(0xcffafe)
                    : new THREE.Color(0xff80bf);
                colors[i * 3] = c.r;
                colors[i * 3 + 1] = c.g;
                colors[i * 3 + 2] = c.b;
            }
            starGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
            starGeo.setAttribute('color', new THREE.BufferAttribute(colors, 3));

            const starMat = new THREE.PointsMaterial({
                size: 0.9,
                vertexColors: true,
                transparent: true,
                opacity: 0.85
            });
            starPoints = new THREE.Points(starGeo, starMat);
            scene.add(starPoints);
        }

